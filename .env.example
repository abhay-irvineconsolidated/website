# Copy to .env.local for local development. Every variable is optional.

# Canonical origin used for metadata, canonical URLs, sitemap and structured data.
# Defaults to https://irvineconsolidated.com when unset.
NEXT_PUBLIC_SITE_URL=https://irvineconsolidated.com

# Contact form endpoint. The form POSTs JSON:
#   { name, email, company, interest, message, source: "website-contact" }
# and expects a 2xx response. Works with Formspree, Basin, a HubSpot Forms
# submission proxy, or your own serverless function.
# When unset, the form falls back to opening a pre-filled email to info@irvineconsolidated.com.
NEXT_PUBLIC_CONTACT_ENDPOINT=
